# Copy this file to .env and fill in your values.

# AWS region hosting your Bedrock model access
AWS_REGION=us-east-1

# Model to use
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# --- Auth: choose ONE of the following ---

# Option A: Bedrock API key (short- or long-term key from the Bedrock console,
# "API keys" section). Simplest option for local dev, no AWS profile needed.
AWS_BEARER_TOKEN_BEDROCK=

# Option B: standard AWS IAM credentials (leave the above blank if using this)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
